{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index", "type", "unknown"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    ".astro/",
    ".vercel/",
    "build/",
    "coverage/",
    "dist/",
    "node_modules/",
    "playwright-report/",
    "test-results/",
    "pnpm-lock.yaml"
  ]
}
